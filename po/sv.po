#: ../qml/AlarmListPage.qml:25 ../qml/SettingsPage.qml:23
msgid "Settings"
msgstr "Inställningar"

#: ../qml/AlarmListPage.qml:40
msgid "Alarm set for %1 – %2"
msgstr "Larm satt till %1 – %2"

#: ../qml/AlarmListPage.qml:67 ../qml/EditAlarmPage.qml:204
msgid "Rings %1"
msgstr "Ringer %1"

#: ../qml/AlarmListPage.qml:118
msgid "Delete"
msgstr "Ta bort"

#: ../qml/AlarmListPage.qml:195
msgid "No alarms yet"
msgstr "Inga larm ännu"

#: ../qml/AlarmListPage.qml:208 ../qml/EditAlarmPage.qml:32
msgid "New alarm"
msgstr "Nytt larm"

#: ../qml/EditAlarmPage.qml:32
msgid "Edit alarm"
msgstr "Redigera larm"

#: ../qml/EditAlarmPage.qml:42
msgid "Save"
msgstr "Spara"

#: ../qml/EditAlarmPage.qml:78 ../qml/EditAlarmPage.qml:261
msgid "Alarm"
msgstr "Larm"

#: ../qml/EditAlarmPage.qml:142
msgid "Could not save the alarm"
msgstr "Kunde inte spara larmet"

#: ../qml/EditAlarmPage.qml:143
msgid "Error code %1. Check that the time is valid and try again."
msgstr "Felkod %1. Kontrollera att tiden är giltig och försök igen."

#: ../qml/EditAlarmPage.qml:145 ../qml/FeedbackPage.qml:109
msgid "OK"
msgstr "OK"

#: ../qml/EditAlarmPage.qml:223
msgid "Repeat"
msgstr "Upprepa"

#: ../qml/EditAlarmPage.qml:251
msgid "Name"
msgstr "Namn"

#: ../qml/EditAlarmPage.qml:293 ../qml/SoundPage.qml:25
msgid "Sound"
msgstr "Ljud"

#: ../qml/EditAlarmPage.qml:317
msgid ""
"The alarm rings even in silent mode and when Waker is closed. Snooze length "
"and alarm volume are set in System Settings → Sound."
msgstr "Larmet ringer även i ljudlöst läge och när Waker är stängd. Snooze-tid och larmvolym ställs in under Systeminställningar → Ljud."

#: ../qml/EditAlarmPage.qml:325
msgid "Delete alarm"
msgstr "Ta bort larm"

#: ../qml/FeedbackPage.qml:35
msgid "Feedback"
msgstr "Feedback"

#: ../qml/FeedbackPage.qml:82
msgid "Too many messages in a short time. Please try again later."
msgstr "För många meddelanden på kort tid. Försök igen senare."

#: ../qml/FeedbackPage.qml:83
msgid "The email address doesn't look valid."
msgstr "E-postadressen ser inte giltig ut."

#: ../qml/FeedbackPage.qml:84
msgid "Please write a little more."
msgstr "Skriv lite mer."

#: ../qml/FeedbackPage.qml:85
msgid "The message is too long."
msgstr "Meddelandet är för långt."

#: ../qml/FeedbackPage.qml:87
msgid "Could not reach the server. Check your internet connection."
msgstr "Kunde inte nå servern. Kontrollera internetanslutningen."

#: ../qml/FeedbackPage.qml:88
msgid "The server could not send the message (error %1)."
msgstr "Servern kunde inte skicka meddelandet (fel %1)."

#: ../qml/FeedbackPage.qml:106
msgid "Thank you!"
msgstr "Tack!"

#: ../qml/FeedbackPage.qml:107
msgid "Your message has been sent to the developer."
msgstr "Ditt meddelande har skickats till utvecklaren."

#: ../qml/FeedbackPage.qml:120
msgid "Could not send"
msgstr "Kunde inte skicka"

#: ../qml/FeedbackPage.qml:123
msgid "Try again"
msgstr "Försök igen"

#: ../qml/FeedbackPage.qml:128
msgid "Use email app instead"
msgstr "Använd e-postappen i stället"

#: ../qml/FeedbackPage.qml:132
msgid "Close"
msgstr "Stäng"

#: ../qml/FeedbackPage.qml:170
msgid "Have an idea for Waker, or did something not work? Tell the developer."
msgstr "Har du en idé till Waker, eller fungerade något inte? Berätta för utvecklaren."

#: ../qml/FeedbackPage.qml:179
msgid "Suggestion"
msgstr "Förslag"

#: ../qml/FeedbackPage.qml:180
msgid "Bug report"
msgstr "Buggrapport"

#: ../qml/FeedbackPage.qml:222
msgid "What happened, and what did you expect to happen?"
msgstr "Vad hände, och vad hade du väntat dig skulle hända?"

#: ../qml/FeedbackPage.qml:223
msgid "Describe your idea…"
msgstr "Beskriv din idé …"

#: ../qml/FeedbackPage.qml:230
msgid "Your email (optional, for a reply)"
msgstr "Din e-post (frivilligt, för svar)"

#: ../qml/FeedbackPage.qml:244
msgid "Include app version and device info"
msgstr "Bifoga appversion och enhetsinfo"

#: ../qml/FeedbackPage.qml:274
msgid "Send"
msgstr "Skicka"

#: ../qml/FeedbackPage.qml:291
msgid "Sent to %1 via waker.sandgren.one. Only what you see here is sent."
msgstr "Skickas till %1 via waker.sandgren.one. Bara det du ser här skickas."

#: ../qml/FeedbackPage.qml:306
msgid "Or write an email to %1"
msgstr "Eller skriv ett mejl till %1"

#: ../qml/SettingsPage.qml:12
msgid "Neon"
msgstr "Neon"

#: ../qml/SettingsPage.qml:13
msgid "Aurora"
msgstr "Norrsken"

#: ../qml/SettingsPage.qml:14
msgid "Ocean"
msgstr "Hav"

#: ../qml/SettingsPage.qml:15
msgid "Ember"
msgstr "Glöd"

#: ../qml/SettingsPage.qml:16
msgid "Ice"
msgstr "Is"

#: ../qml/SettingsPage.qml:59
msgid "Theme"
msgstr "Tema"

#: ../qml/SettingsPage.qml:118
msgid "Animated background"
msgstr "Animerad bakgrund"

#: ../qml/SettingsPage.qml:122
msgid "Turn off to save battery on older phones."
msgstr "Stäng av för att spara batteri på äldre telefoner."

#: ../qml/SettingsPage.qml:148
msgid "Volume, vibration and snooze"
msgstr "Volym, vibration och snooze"

#: ../qml/SettingsPage.qml:152
msgid ""
"These are shared by all alarms on the phone and are set in System Settings."
msgstr "De gäller alla larm på telefonen och ställs in i Systeminställningar."

#: ../qml/SettingsPage.qml:157
msgid "Open sound settings"
msgstr "Öppna ljudinställningar"

#: ../qml/SettingsPage.qml:174
msgid "Ideas or problems?"
msgstr "Idéer eller problem?"

#: ../qml/SettingsPage.qml:178
msgid "Send a suggestion or a bug report straight to the developer."
msgstr "Skicka ett förbättringsförslag eller en buggrapport direkt till utvecklaren."

#: ../qml/SettingsPage.qml:184
msgid "Send feedback"
msgstr "Skicka feedback"

#: ../qml/SettingsPage.qml:210
msgid ""
"Waker uses the phone's built-in alarm service. Alarms ring even in silent "
"mode, wake the phone from sleep and work when the app is closed. Alarms are "
"shared with the Clock app."
msgstr "Waker använder telefonens inbyggda larmtjänst. Larmen ringer även i ljudlöst läge, väcker telefonen ur viloläge och fungerar när appen är stängd. Larmen delas med Klock-appen."

#: ../qml/SettingsPage.qml:249
msgid "Made by Fredrik Sandgren · Free software, GPL-3.0"
msgstr "Skapad av Fredrik Sandgren · Fri programvara, GPL-3.0"

#: ../qml/SoundPage.qml:34
msgid "Import sound"
msgstr "Importera ljud"

#: ../qml/SoundPage.qml:81
msgid "Import sound from"
msgstr "Importera ljud från"

#: ../qml/SoundPage.qml:155
msgid "My sounds"
msgstr "Mina ljud"

#: ../qml/SoundPage.qml:158
msgid "Tap + to import a sound file from another app."
msgstr "Tryck på + för att importera en ljudfil från en annan app."

#: ../qml/SoundPage.qml:162
msgid "System sounds"
msgstr "Systemljud"

#: ../qml/components/AlarmUtils.qml:49 ../qml/components/DayChips.qml:67
msgid "Once"
msgstr "En gång"

#: ../qml/components/AlarmUtils.qml:51 ../qml/components/DayChips.qml:70
msgid "Every day"
msgstr "Varje dag"

#: ../qml/components/AlarmUtils.qml:53 ../qml/components/DayChips.qml:68
msgid "Weekdays"
msgstr "Vardagar"

#: ../qml/components/AlarmUtils.qml:55 ../qml/components/DayChips.qml:69
msgid "Weekends"
msgstr "Helger"

#. TRANSLATORS: time until the alarm, e.g. "in 1 d 3 h"
#: ../qml/components/AlarmUtils.qml:109
msgid "in %1 d %2 h"
msgstr "om %1 d %2 h"

#. TRANSLATORS: time until the alarm, e.g. "in 7 h 12 min"
#: ../qml/components/AlarmUtils.qml:112
msgid "in %1 h %2 min"
msgstr "om %1 h %2 min"

#. TRANSLATORS: time until the alarm, e.g. "in 4 min"
#: ../qml/components/AlarmUtils.qml:114
msgid "in %1 min"
msgstr "om %1 min"

#: ../qml/components/AlarmUtils.qml:127
msgid "Default"
msgstr "Standard"

#: ../qml/components/AlarmUtils.qml:132
msgid "Dawn"
msgstr "Gryning"

#: ../qml/components/AlarmUtils.qml:133
msgid "Classic"
msgstr "Klassisk"

#: ../qml/components/AlarmUtils.qml:134
msgid "Pulse"
msgstr "Puls"

#: ../qml/components/NextAlarmBanner.qml:71
msgid "Next alarm"
msgstr "Nästa larm"

#: ../qml/components/NextAlarmBanner.qml:71
msgid "No active alarms"
msgstr "Inga aktiva larm"

#: ../qml/components/NextAlarmBanner.qml:104
msgid ""
"Tap + to set an alarm. Waker rings even when the phone is in silent mode."
msgstr "Tryck på + för att ställa ett larm. Waker ringer även när telefonen är i ljudlöst läge."

